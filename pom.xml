<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd" child.project.url.inherit.append.path="false">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.vadimbabich</groupId>
  <artifactId>entity-metamodel-parent</artifactId>
  <version>2.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Entity Metamodel (parent)</name>
  <description>
    Reactor parent for the entity-metamodel family: one aligned version line across every module,
    released together. Versions are set ephemerally from the release workflow's dispatch inputs —
    nothing here is ever the release version of record.
  </description>
  <url>https://github.com/VadimBabich/entity-metamodel</url>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>vadimbabich</id>
      <name>Vadim Babich</name>
      <url>https://github.com/VadimBabich</url>
    </developer>
  </developers>

  <!-- All artifacts share one repository, so inherited URLs must not get the module directory
       appended. The attributes belong on <scm> itself; on <url>/<connection> they parse as
       unknown and are silently dropped. -->
  <scm child.scm.connection.inherit.append.path="false"
       child.scm.developerConnection.inherit.append.path="false"
       child.scm.url.inherit.append.path="false">
    <connection>scm:git:https://github.com/VadimBabich/entity-metamodel.git</connection>
    <developerConnection>scm:git:https://github.com/VadimBabich/entity-metamodel.git</developerConnection>
    <url>https://github.com/VadimBabich/entity-metamodel</url>
    <tag>HEAD</tag>
  </scm>

  <modules>
    <module>entity-metamodel-bom</module>
    <module>entity-metamodel-core</module>
    <module>entity-metamodel-runtime</module>
    <module>entity-metamodel-runtime-r2dbc</module>
    <module>entity-metamodel-processor</module>
  </modules>

  <properties>
    <java.release>17</java.release>
    <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Stamped by the release workflow, not by any plugin. Never hand-edit mid-cycle. -->
    <project.build.outputTimestamp>2026-08-08T00:00:00Z</project.build.outputTimestamp>

    <!-- Version numbers only, nothing declared or managed: a BOM import pulls the imported POM's
         effective dependencyManagement, parent-inherited entries included, so anything managed
         here would reach every consumer of entity-metamodel-bom. -->
    <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
    <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.6.0</maven-surefire-plugin.version>
    <maven-failsafe-plugin.version>3.6.0</maven-failsafe-plugin.version>

    <junit.version>6.1.3</junit.version>
    <assertj-core.version>3.27.7</assertj-core.version>
    <!-- Supported substrate range is Spring Data 4.0.x-4.1.x. One property for all three of its
         artifacts on purpose: they ship as one release train, so a tool that bumps dependencies one
         at a time must not be able to produce a mixed set — that failure is a linkage error at
         runtime, not a broken build. Reactor is pinned to the version spring-data-r2dbc itself
         declares, so the direct and transitive views agree. -->
    <spring-data.version>4.1.1</spring-data.version>
    <spring-r2dbc.version>7.0.9</spring-r2dbc.version>
    <reactor.version>3.8.7</reactor.version>

    <!-- Execution-layer test substrate only: Testcontainers PostgreSQL on the 2.x coordinates,
         driven through r2dbc-postgresql. Never compile-scope. -->
    <testcontainers.version>2.0.5</testcontainers.version>
    <r2dbc-postgresql.version>1.1.2.RELEASE</r2dbc-postgresql.version>
    <r2dbc-proxy.version>1.1.6.RELEASE</r2dbc-proxy.version>
    <netty.version>4.1.137.Final</netty.version>
  </properties>

  <build>
    <pluginManagement>
      <plugins>
        <!-- Super-POM defaults vary with the local Maven version, which would make jar bytes
             environment-dependent. pluginManagement is never exported to a BOM consumer — only
             dependencyManagement is — so managing configuration here is safe, and it reaches every
             module at once, which for the lint contract is the intent. Automatic-Module-Name stays
             per module: it is module identity, and a managed default would let a new module inherit
             a wrong or unresolved name silently. -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${maven-jar-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
          <configuration>
            <release>${java.release}</release>
            <compilerArgs>
              <arg>-Xlint:all</arg>
            </compilerArgs>
            <failOnWarning>true</failOnWarning>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>${maven-failsafe-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!-- The reactor's only floor check; nothing else enforces either version. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>${maven-enforcer-plugin.version}</version>
        <executions>
          <execution>
            <id>enforce-environment</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireMavenVersion>
                  <version>[3.9,)</version>
                </requireMavenVersion>
                <requireJavaVersion>
                  <version>[17,)</version>
                </requireJavaVersion>
                <banDuplicatePomDependencyVersions/>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Not always-on: GPG must not run on pull request or dev builds. Inert until a release
         dispatch activates it. -->
    <profile>
      <id>release</id>
      <properties>
        <!-- Stays true for every build; the release workflow overrides it once it has verified
             the signing secrets exist. -->
        <gpg.skip>true</gpg.skip>
        <!-- A sentinel, not a default: a value that cannot be a version means a release which
             forgets to pass the dispatched one fails instead of comparing the tree against
             itself. -->
        <expected.release.version>UNSET</expected.release.version>
      </properties>
      <build>
        <plugins>
          <!-- Central is immutable, so a module left on the wrong version publishes permanently.
               enforcer runs in every module, so this compares each module's effective version —
               inherited from the parent or declared by the module itself, which versions:set does
               not rewrite — against the version the dispatch asked for. -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-enforcer-plugin</artifactId>
            <executions>
              <execution>
                <id>enforce-release-version</id>
                <goals>
                  <goal>enforce</goal>
                </goals>
                <configuration>
                  <rules>
                    <evaluateBeanshell>
                      <condition>"${project.version}".equals("${expected.release.version}")</condition>
                      <message>This module is at ${project.version} but the release asked for
                        ${expected.release.version}. UNSET means the deploy did not pass
                        -Dexpected.release.version; any other value means the version stamp did not
                        reach every module.</message>
                    </evaluateBeanshell>
                  </rules>
                </configuration>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.4.0</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.12.0</version>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.8</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.cyclonedx</groupId>
            <artifactId>cyclonedx-maven-plugin</artifactId>
            <version>2.9.3</version>
            <configuration>
              <outputName>${project.artifactId}-bom</outputName>
            </configuration>
            <executions>
              <execution>
                <id>make-sbom</id>
                <phase>package</phase>
                <goals>
                  <goal>makeBom</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.11.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <!-- The deployment stops at VALIDATED; publishing or dropping it is an explicit
                   act. -->
              <autoPublish>false</autoPublish>
              <waitUntil>validated</waitUntil>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>
