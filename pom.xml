<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd" child.project.url.inherit.append.path="false">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.vadimbabich</groupId>
  <artifactId>entity-metamodel-parent</artifactId>
  <version>2.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Entity Metamodel (parent)</name>
  <description>
    Reactor parent for the entity-metamodel family and the retiring 1.x Maven plugin. The reactor
    is deliberately mixed-version by design: the family releases from this version line; the
    plugin module keeps its own 1.1.x line and coordinates for its remaining releases. Releases
    are cut per line with scoped versions:set from dispatch inputs — nothing here is ever the
    release version of record.
  </description>
  <url>https://github.com/VadimBabich/entity-metamodel</url>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>vadimbabich</id>
      <name>Vadim Babich</name>
      <url>https://github.com/VadimBabich</url>
    </developer>
  </developers>

  <!-- All artifacts share one repository, so inherited URLs must not get the module directory
       appended. The attributes belong on <scm> itself; on <url>/<connection> they parse as
       unknown and are silently dropped. -->
  <scm child.scm.connection.inherit.append.path="false"
       child.scm.developerConnection.inherit.append.path="false"
       child.scm.url.inherit.append.path="false">
    <connection>scm:git:https://github.com/VadimBabich/entity-metamodel.git</connection>
    <developerConnection>scm:git:https://github.com/VadimBabich/entity-metamodel.git</developerConnection>
    <url>https://github.com/VadimBabich/entity-metamodel</url>
    <tag>HEAD</tag>
  </scm>

  <modules>
    <module>jpa-metadata-maven-plugin</module>
    <module>entity-metamodel-bom</module>
    <module>entity-metamodel-core</module>
    <module>entity-metamodel-runtime</module>
  </modules>

  <properties>
    <java.release>17</java.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Stamped by the release workflow, not by any plugin. Never hand-edit mid-cycle. -->
    <project.build.outputTimestamp>2026-08-08T00:00:00Z</project.build.outputTimestamp>

    <!-- Version numbers only, nothing declared or managed: a BOM import pulls the imported
         POM's effective dependencyManagement, parent-inherited entries included, so anything
         managed here would reach every consumer of entity-metamodel-bom. -->
    <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
    <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.5.3</maven-surefire-plugin.version>

    <junit.version>5.13.1</junit.version>
    <assertj-core.version>3.27.7</assertj-core.version>
  </properties>

  <build>
    <pluginManagement>
      <plugins>
        <!-- Super-POM defaults vary with the local Maven version, which would make jar bytes
             environment-dependent. Versions only; configuration stays per module. -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${maven-jar-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <!-- Inherited so a reactor-wide deploy resolves one repository. -->
  <distributionManagement>
    <repository>
      <id>github</id>
      <name>GitHub Packages</name>
      <url>https://maven.pkg.github.com/VadimBabich/entity-metamodel</url>
    </repository>
  </distributionManagement>

  <profiles>
    <!-- Not always-on: GPG must not run on PRs or dev builds. Inert until a release
         dispatch activates it. -->
    <profile>
      <id>release</id>
      <properties>
        <!-- Stays true for every build; the release workflow overrides it once it has
             verified the signing secrets exist. -->
        <gpg.skip>true</gpg.skip>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.3.1</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.12.0</version>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.8</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.cyclonedx</groupId>
            <artifactId>cyclonedx-maven-plugin</artifactId>
            <version>2.9.3</version>
            <configuration>
              <outputName>${project.artifactId}-bom</outputName>
            </configuration>
            <executions>
              <execution>
                <id>make-sbom</id>
                <phase>package</phase>
                <goals>
                  <goal>makeBom</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.11.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <!-- The deployment stops at VALIDATED; publishing or dropping it is an
                   explicit act. -->
              <autoPublish>false</autoPublish>
              <waitUntil>validated</waitUntil>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>
