<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.vadimbabich</groupId>
    <artifactId>entity-metamodel-parent</artifactId>
    <version>2.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>entity-metamodel-runtime</artifactId>

  <name>Entity Metamodel Runtime</name>
  <description>
    Resolution core of the entity metamodel: EntityRef and PropertyRef (pure data, instance-scoped
    aliases, value equality), name resolution through Spring's mapping context, and the owned
    Generated and RawSql markers. Contains no Spring component, no configuration, and no static
    mutable state — consumers wire one executor bean themselves (D3).
  </description>

  <dependencies>
    <!-- The dependency surface is deliberate: the resolution core is RELATIONAL-ONLY.
         spring-data-r2dbc belongs to the execution module, never here. -->
    <dependency>
      <groupId>org.springframework.data</groupId>
      <artifactId>spring-data-relational</artifactId>
      <version>${spring-data.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj-core.version}</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.revapi</groupId>
        <artifactId>revapi-maven-plugin</artifactId>
        <configuration>
          <analysisConfiguration>
            <revapi.differences>
              <differences>
                <!-- Order is load-bearing: the recipe transform is first-match-wins, so the admit
                     must precede the raise or it would never apply. The admit is a namespace
                     rather than a type list because the check reports the whole closure one
                     exposed class drags in - RelationalMappingContext alone pulls Spring's
                     mapping, SpEL and asm graphs. Per-type policy lives in
                     ArchitectureRulesTest. -->
                <item>
                  <ignore>true</ignore>
                  <regex>true</regex>
                  <code>java\.class\.externalClassExposedInAPI</code>
                  <new>(class|interface|enum|@interface) org\.springframework\..*</new>
                  <justification>The substrate range ADR admits relational.core.mapping on this
                    module's surface (PropertyRef.columnName); everything else springframework
                    here is that type's own signature closure.</justification>
                </item>
                <item>
                  <code>java.class.externalClassExposedInAPI</code>
                  <criticality>error</criticality>
                  <justification>Any non-substrate dependency type reaching the public surface is
                    a leak; nothing else is admitted.</justification>
                </item>
              </differences>
            </revapi.differences>
          </analysisConfiguration>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifestEntries>
              <Automatic-Module-Name>io.github.vadimbabich.entitymetamodel.runtime</Automatic-Module-Name>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
