<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.vadimbabich</groupId>
    <artifactId>entity-metamodel-parent</artifactId>
    <version>2.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>entity-metamodel-runtime-r2dbc</artifactId>

  <name>Entity Metamodel Runtime (R2DBC)</name>
  <description>
    Reactive fluent query builder for Spring Data R2DBC: FluentSelect with
    type-safe predicates, instance-scoped aliases, bind-marker ownership, and multi-entity
    hydration. No static mutable state; resolution via injected R2dbcEntityTemplate.
    Supports Spring Data Relational 4.0.x–4.1.x.
  </description>

  <dependencyManagement>
    <dependencies>
      <!-- The r2dbc-postgresql test driver drags reactor-netty's netty 4.1.112, which carries
           several published advisories. Test scope never reaches a consumer, but leaving known-
           vulnerable jars on any classpath means every scanner run has to re-triage them. Pinned
           within the binary-compatible 4.1 line. A leaf module's dependencyManagement is not
           inherited by consumers of its artifact, so this stays local. -->
      <dependency>
        <groupId>io.netty</groupId>
        <artifactId>netty-bom</artifactId>
        <version>${netty.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Resolution core sits in the relational module; this module adds r2dbc execution. -->
    <dependency>
      <groupId>io.github.vadimbabich</groupId>
      <artifactId>entity-metamodel-runtime</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- The execution substrate. Declared with an explicit version rather than through a
         Spring Boot BOM import: Boot's train pins Spring Data to its own line, which silently
         resolved below the 4.0.x floor this module supports. -->
    <dependency>
      <groupId>org.springframework.data</groupId>
      <artifactId>spring-data-r2dbc</artifactId>
      <version>${spring-data.version}</version>
    </dependency>

    <!-- Declared directly because DatabaseClient appears in this module's own public signatures and
         its bind-marker types carry every value it renders. It resolves transitively through
         spring-data-r2dbc, so the version moves with that line rather than independently. -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-r2dbc</artifactId>
      <version>${spring-r2dbc.version}</version>
    </dependency>

    <!-- Declared directly because Page/Pageable appear in this module's own public signatures. It
         resolves transitively through spring-data-r2dbc anyway, so the version must move with that
         line: the three artifacts ship as one release train and mixing them is unsupported. -->
    <dependency>
      <groupId>org.springframework.data</groupId>
      <artifactId>spring-data-commons</artifactId>
      <version>${spring-data.version}</version>
    </dependency>

    <!-- Declared directly because Mono/Flux appear in this module's own public signatures. -->
    <dependency>
      <groupId>io.projectreactor</groupId>
      <artifactId>reactor-core</artifactId>
      <version>${reactor.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj-core.version}</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>io.projectreactor</groupId>
      <artifactId>reactor-test</artifactId>
      <version>${reactor.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- Execution layer only: the *IT suite runs statements against a real PostgreSQL, because
         rendering can be proved on paper and executing cannot. Never compile-scope. -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <version>${testcontainers.version}</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>r2dbc-postgresql</artifactId>
      <version>${r2dbc-postgresql.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <release>${java.release}</release>
          <compilerArgs>
            <arg>-Xlint:all</arg>
          </compilerArgs>
          <failOnWarning>true</failOnWarning>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>

      <!-- Container-backed tests are *IT and run under failsafe, so `mvn test` stays hermetic and
           needs no Docker while `mvn verify` proves execution against a real database. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifestEntries>
              <!-- JPMS posture: stable automatic module name. -->
              <Automatic-Module-Name>io.github.vadimbabich.entitymetamodel.runtime.r2dbc</Automatic-Module-Name>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
