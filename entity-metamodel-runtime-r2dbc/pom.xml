<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.vadimbabich</groupId>
    <artifactId>entity-metamodel-parent</artifactId>
    <version>2.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>entity-metamodel-runtime-r2dbc</artifactId>

  <properties>
    <blockhound.attach.args/>
  </properties>

  <profiles>
    <!-- JEP 451: from JDK 21 a dynamic agent attach warns unless allowed explicitly. The flag
         reached 17 only in 17.0.12 and the floor is [17,), so it cannot be unconditional. -->
    <profile>
      <id>jdk-21-plus</id>
      <activation>
        <jdk>[21,)</jdk>
      </activation>
      <properties>
        <blockhound.attach.args>-XX:+EnableDynamicAgentLoading</blockhound.attach.args>
      </properties>
    </profile>
  </profiles>

  <name>Entity Metamodel Runtime (R2DBC)</name>
  <description>
    Reactive fluent query builder for Spring Data R2DBC: FluentSelect with
    type-safe predicates, instance-scoped aliases, bind-marker ownership, and multi-entity
    hydration. No static mutable state; resolution via injected R2dbcEntityTemplate.
    Supports Spring Data Relational 4.0.x–4.1.x.
  </description>

  <dependencyManagement>
    <dependencies>
      <!-- The r2dbc-postgresql test driver pulls reactor-netty-core 1.1.22, which declares netty
           4.1.112 — a version carrying published advisories. Test scope reaches no consumer, but
           known-vulnerable jars on any classpath mean re-triaging them on every scanner run, so
           netty is pinned forward to the newest 4.1 patch.
           **Forward within 4.1, never across the minor.** netty patches both lines for the same
           advisories, so 4.2 buys no fix; reactor-netty did not support 4.2 before its own 1.3.x
           line, so 4.2 under 1.1.22 is a combination its authors do not ship, and it also splits
           netty-codec into artifacts 4.1 does not have. Dependabot is capped below 4.2 for the
           same reason. A leaf module's dependencyManagement is not inherited by consumers of its
           artifact, so this stays local. -->
      <dependency>
        <groupId>io.netty</groupId>
        <artifactId>netty-bom</artifactId>
        <version>${netty.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>io.github.vadimbabich</groupId>
      <artifactId>entity-metamodel-runtime</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- The execution substrate, declared with an explicit version rather than through a Spring
         Boot BOM import: Boot's train pins Spring Data to its own line, which silently resolved
         below the 4.0.x floor this module supports. -->
    <dependency>
      <groupId>org.springframework.data</groupId>
      <artifactId>spring-data-r2dbc</artifactId>
      <version>${spring-data.version}</version>
    </dependency>

    <!-- Declared directly because DatabaseClient appears in this module's own public signatures
         and its bind-marker types carry every value it renders. It resolves transitively through
         spring-data-r2dbc, so the version moves with that line rather than independently. -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-r2dbc</artifactId>
      <version>${spring-r2dbc.version}</version>
    </dependency>

    <!-- Declared directly because Page/Pageable appear in this module's own public signatures.
         The version must move with spring-data-r2dbc: the three artifacts ship as one release
         train and mixing them is unsupported. -->
    <dependency>
      <groupId>org.springframework.data</groupId>
      <artifactId>spring-data-commons</artifactId>
      <version>${spring-data.version}</version>
    </dependency>

    <!-- Declared directly because Mono/Flux appear in this module's own public signatures. -->
    <dependency>
      <groupId>io.projectreactor</groupId>
      <artifactId>reactor-core</artifactId>
      <version>${reactor.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj-core.version}</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>io.projectreactor</groupId>
      <artifactId>reactor-test</artifactId>
      <version>${reactor.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- Execution layer only: the *IT suite runs statements against a real PostgreSQL, because
         rendering can be proved on paper and execution cannot. Never compile-scope. -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <version>${testcontainers.version}</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>r2dbc-postgresql</artifactId>
      <version>${r2dbc-postgresql.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- The *IT suite has to assert which statements were executed and, above all, which were
         not: the count a slice avoids leaves no other trace. The R2DBC project's own listener SPI,
         observing executions rather than statement creation. -->
    <dependency>
      <groupId>io.r2dbc</groupId>
      <artifactId>r2dbc-proxy</artifactId>
      <version>${r2dbc-proxy.version}</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- Reactive style §9/§10: an accidental blocking call in a chain fails the *IT suite rather
         than degrading production silently. -->
    <dependency>
      <groupId>io.projectreactor.tools</groupId>
      <artifactId>blockhound</artifactId>
      <version>${blockhound.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Container-backed tests are *IT and run under failsafe, so `mvn test` stays hermetic
           and needs no Docker while `mvn verify` proves execution against a real database. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <!-- BlockHound instruments via class redefinition, which JDK 13+ forks refuse without
             this flag. The attach flag it also wants is conditional; see the profile above. -->
        <configuration>
          <argLine>-XX:+AllowRedefinitionToAddDeleteMethods ${blockhound.attach.args}</argLine>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.revapi</groupId>
        <artifactId>revapi-maven-plugin</artifactId>
        <configuration>
          <analysisConfiguration>
            <revapi.differences>
              <differences>
                <!-- Order is load-bearing: the recipe transform is first-match-wins, so the admit
                     must precede the raise or it would never apply. Admits are namespaces rather
                     than type lists because the check reports the whole closure the admitted roots
                     drag in; per-type policy lives in ArchitectureRulesTest. The sibling pattern
                     matches top-level types only - if a nested runtime type ever enters the
                     closure, append (\.[A-Za-z0-9]+)* to that alternative rather than reordering
                     these items. -->
                <item>
                  <ignore>true</ignore>
                  <regex>true</regex>
                  <code>java\.class\.externalClassExposedInAPI</code>
                  <new>(class|interface|enum|@interface) (org\.springframework\..*|reactor\..*|io\.r2dbc\.spi\..*|org\.reactivestreams\..*|io\.github\.vadimbabich\.entitymetamodel\.runtime\.[A-Za-z0-9]+(&lt;.*&gt;)?)</new>
                  <justification>The execution module is the designated adapter surface: the
                    substrate-range and escape-hatch ADRs admit these namespaces here, and the
                    sibling vocabulary is this family's own API.</justification>
                </item>
                <item>
                  <code>java.class.externalClassExposedInAPI</code>
                  <criticality>error</criticality>
                  <justification>Any dependency type outside the admitted namespaces reaching the
                    public surface is a leak; Tier-S types never appear even inside them, enforced
                    at signature level by ArchitectureRulesTest.</justification>
                </item>
              </differences>
            </revapi.differences>
          </analysisConfiguration>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifestEntries>
              <Automatic-Module-Name>io.github.vadimbabich.entitymetamodel.runtime.r2dbc</Automatic-Module-Name>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
